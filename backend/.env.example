# ================================================================
# Pakistan AI Legal Aid — Environment Variables
# Copy this file to .env and fill in your values
# ================================================================

# Groq API Key (Required — free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Public Groq production models; override only with models available to your account.
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ElevenLabs TTS API Key (Optional)
ELEVENLABS_API_KEY=

# Admin Dashboard Password (change this!)
ADMIN_PASSWORD=replace_with_a_long_unique_password

# Comma-separated browser origins; wildcard origins are intentionally rejected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://legal-aid-react.vercel.app

# On Render, point this at a persistent disk, e.g. /var/data/legal-aid/database.db.
# DATABASE_PATH=/var/data/legal-aid/database.db

# Aggregate analytics are saved by default, without raw questions or AI summaries.
STORE_QUERY_TEXT=false

# If Tesseract is unavailable, images can be transcribed using the existing Groq key.
OCR_VISION_FALLBACK=true
GROQ_OCR_MODEL=qwen/qwen3.8-27b

# Input validation
MAX_QUERY_LENGTH=2000
MIN_QUERY_LENGTH=15
